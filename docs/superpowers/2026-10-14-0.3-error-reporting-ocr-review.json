    },
    {
      "path": "app/src/main/java/tv/own/owntv/kevbox/errors/ErrorQueue.kt",
      "content": "Rejections are counted per batch, but the queue deletes entries one by one. If the server refuses a batch because of one bad entry (for example a malformed field), all the valid entries in that batch (up to 50) also get their counter raised. After 3 tries they are all deleted. The same batch is usually sent again with the same members, so one bad entry can wipe out up to 50 good reports. There is a second problem: `add` can merge new occurrences into an item whose `rejections` count is already above 0, so those fresh reports start out with the old count. Some options: once a batch has been rejected, retry it with a smaller batch size (or one entry at a time) so the bad entry can be found; or don't merge into items that have `rejections \u003e 0`.",
      "existing_code": "                items.removeAll { it.id in settled \u0026\u0026 it.rejections \u003e= SendPolicy.MAX_REJECTIONS }",
      "start_line": 88,
      "end_line": 88,
      "category": "bug",
      "severity": "medium"
    }
