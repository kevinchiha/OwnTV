<?xml version="1.0" encoding="utf-8"?>
<!-- KevBox Live fork only: member-facing text. Says "admin", never a person's name. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="kevbox_sign_in_title">Sign in to KevBox Live</string>
    <string name="kevbox_sign_in_hint">Use your KevBox email and password.</string>
    <string name="kevbox_email">Email</string>
    <string name="kevbox_password">Password</string>
    <string name="kevbox_sign_in">Sign in</string>
    <string name="kevbox_wrong_credentials">Wrong email or password</string>
    <string name="kevbox_no_internet">No internet connection</string>
    <string name="kevbox_sign_in_failed">Sign-in failed. Try again.</string>
    <string name="kevbox_retry">Retry</string>
    <string name="kevbox_choose_your_playlist">Choose your playlist</string>
    <string name="kevbox_choose_playlist">Choose playlist</string>
    <string name="kevbox_current_playlist">Current</string>
    <string name="kevbox_no_playlist">No playlist assigned yet. Contact admin.</string>
    <string name="kevbox_access_locked">Access locked. Contact admin.</string>
    <string name="kevbox_expired">Your subscription has expired. Contact admin to renew.</string>
    <string name="kevbox_expiring_one">Your subscription expires in 1 day. Contact admin to renew.</string>
    <!-- Two plain strings on purpose, not <plurals>: CJK locales never pick "one", so N = 1 would read "1 days".
         Code picks kevbox_expiring_one for N = 1, so lint's PluralsCandidate check does not apply here. -->
    <string name="kevbox_expiring_other" tools:ignore="PluralsCandidate">Your subscription expires in %d days. Contact admin to renew.</string>
    <string name="kevbox_ok">OK</string>
    <string name="kevbox_account">Account</string>
    <string name="kevbox_sign_out">Sign out</string>
    <string name="kevbox_sign_out_confirm">Sign out of KevBox Live?</string>
    <string name="kevbox_cancel">Cancel</string>
    <!-- Live TV grid key hint: OK puts the channel in the preview box (a second OK watches it full screen). -->
    <string name="kevbox_key_preview">Preview</string>
    <!-- Search key hint, after "Hold OK": holding OK on a channel opens it in the Live TV guide, in its category. -->
    <string name="kevbox_key_guide">Guide</string>
    <!-- Category list key hint, after "Hold OK": opens the Jump to list of category blocks. -->
    <string name="kevbox_key_jump">Jump</string>
    <!-- Title of the list Hold OK opens in the category list: one line per block of categories (FR|, US|...). -->
    <string name="kevbox_jump_title">Jump to</string>
    <!-- Jump to line for the fixed rows at the top of the category list. -->
    <string name="kevbox_jump_top">Favorites &amp; All channels</string>
    <!-- Jump to line for categories that belong to no block. -->
    <string name="kevbox_jump_other">Other</string>
    <!-- Search finds channels and TV programs only (no movies or series in KevBox Live). -->
    <string name="kevbox_search_field_hint">Channels and TV programs</string>
    <string name="kevbox_search_card_body">Channels from your playlist, and TV programs on now or later today by their title. OK plays a result here; hold OK to open it in the guide.</string>
    <string name="kevbox_search_nothing_found_body">Search looks in channel names and in the program titles of the downloaded guide. Hidden categories are not searched.</string>
</resources>
