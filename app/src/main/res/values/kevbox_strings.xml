    <!-- Live TV grid key hint: OK puts the channel in the preview box (a second OK watches it full screen). -->
    <string name="kevbox_key_preview">Preview</string>
    <!-- Search key hint, after "Hold OK": holding OK on a channel opens it in the Live TV guide, in its category. -->
    <string name="kevbox_key_guide">Guide</string>
    <!-- Category list key hint, after "Hold OK": opens the Jump to list of category blocks. -->
    <string name="kevbox_key_jump">Jump</string>
    <!-- Title of the list Hold OK opens in the category list: one line per block of categories (FR|, US|...). -->
    <string name="kevbox_jump_title">Jump to</string>
    <!-- Jump to line for the fixed rows at the top of the category list. -->
    <string name="kevbox_jump_top">Favorites &amp; All channels</string>
    <!-- Jump to line for categories that belong to no block. -->
    <string name="kevbox_jump_other">Other</string>
    <!-- Search finds channels and TV programs only (no movies or series in KevBox Live). -->
    <string name="kevbox_search_field_hint">Channels and TV programs</string>
    <string name="kevbox_search_card_body">Channels from your playlist, and TV programs on now or in the next 24 hours by their title. OK plays a result here; hold OK to open it in the guide.</string>
    <string name="kevbox_search_nothing_found_body">Search looks in channel names and in the program titles of the downloaded guide. Hidden categories are not searched.</string>
    <!-- Search, the second tab under the field (the first is Channels): programs from the guide whose title matches, with their count after it. -->
    <string name="kevbox_search_tab_guide">TV guide</string>
    <!-- Search key hint, after "▲", while the Channels / TV guide tabs are up: ▲ from the top row goes to the tabs. -->
    <string name="kevbox_key_tabs">Tabs</string>
    <!-- Search's TV guide tab, and the Live TV guide grid while its search has text: heading over the matching programs (or their channels) on now, shown in capitals with the count ("ON NOW · 3"). -->
    <string name="kevbox_shows_on_now">On now</string>
    <!-- Search's TV guide tab, and the Live TV guide grid while its search has text: heading over the matching programs (or their channels) that start in the next 24 hours, shown in capitals with the count. -->
    <string name="kevbox_shows_next_24_hours">Next 24 hours</string>
    <!-- 0.2 AC-4: the "Watching & recording" group and its headings, with recording gone. -->
    <string name="kevbox_settings_group_watching">Watching</string>
    <string name="kevbox_settings_vp_cat_controls_catchup">Controls &amp; catch-up</string>
    <string name="kevbox_settings_vp_cat_mini_player">Mini-player</string>
    <!-- 0.2 AC-17: movie and episode rows that only act on catch-up now. -->
    <string name="kevbox_settings_catchup_next">Catch-up: play the next programme</string>
    <string name="kevbox_settings_catchup_next_description">When a catch-up programme ends, the next programme on the same channel starts.</string>
    <string name="kevbox_settings_line_catchup_next">The next programme on the same channel</string>
    <string name="kevbox_settings_seek_step">Catch-up seek step</string>
    <string name="kevbox_settings_seek_step_description">How far rewind and forward jump in catch-up.</string>
    <string name="kevbox_settings_line_seek_step">How far rewind and forward jump in catch-up</string>
    <string name="kevbox_settings_help_seek_step">How far rewind and forward jump in catch-up with one press. Holding the key keeps jumping.</string>
    <string name="kevbox_settings_catchup_buffer">Catch-up buffer</string>
    <string name="kevbox_settings_catchup_buffer_description">How far ahead catch-up is loaded. Auto uses what suits this device. A longer buffer rides out a bad connection better; the memory of this device still sets the limit, so a high-bitrate programme may hold less than chosen.</string>
    <string name="kevbox_settings_line_catchup_buffer">How far ahead catch-up is loaded</string>
    <string name="kevbox_settings_catchup_timeout">Catch-up network timeout</string>
    <string name="kevbox_settings_catchup_timeout_description">How long catch-up waits on a silent server before the connection counts as lost. Auto keeps the wait of each player: 60 seconds on mpv, 20 on ExoPlayer.</string>
    <string name="kevbox_settings_catchup_reconnects">Catch-up reconnect attempts</string>
    <string name="kevbox_settings_catchup_reconnects_description">How many times a catch-up programme that loses its connection is reopened where it stopped before an error is shown. A minute of steady playback earns the attempts back.</string>
    <!-- 0.2 AC-18: App startup opens Live TV, not Home. -->
    <string name="kevbox_settings_startup_live_tv">Live TV</string>
    <string name="kevbox_settings_startup_channel_unavailable">The startup channel is unavailable. Live TV was opened.</string>
    <!-- 0.2 gap settings-3: help lines for App startup and Live preview. -->
    <string name="kevbox_settings_help_startup">What KevBox Live shows when it starts: Live TV, the last channel, Live TV on Favorites, or a channel you pick.</string>
    <string name="kevbox_settings_help_live_preview">Plays the channel you move to in the box at the top of the guide, without pressing OK.</string>
    <!-- 0.2 AC-11: group summaries and More › Settings card lines that name nothing hidden. -->
    <string name="kevbox_settings_group_summary_layout">Navigation, guide width and remote shortcuts</string>
    <string name="kevbox_settings_group_summary_appearance">Theme, glass, motion and text size</string>
    <string name="kevbox_settings_card_layout">Navigation, guide width, remote shortcuts</string>
    <string name="kevbox_settings_card_appearance">Theme, glass, text, motion</string>
    <string name="kevbox_settings_card_player">Saved choices, external player, streaming</string>
    <string name="kevbox_settings_card_watching">Skip steps, catch-up, mini-player</string>
    <!-- 0.2 AC-5: the External player row, its dialog and its help line, with the Live TV switch alone. -->
    <string name="kevbox_settings_external_player_description">Opens live channels in another video app installed on the TV.</string>
    <string name="kevbox_settings_external_player_row_description">Opens live channels in another video app installed on the TV (VLC, MX Player) instead of the built-in player. Useful for a channel this app can\'t decode, or if you prefer another player. Previous and next channel are unavailable while another app plays; channels that need a custom User-Agent or referer may not play.</string>
    <string name="kevbox_settings_line_external">VLC, MX Player… for live channels</string>
    <!-- 0.2 AC-3: the kept "Reset saved live TV player choices" row, without the hidden Live TV player setting. -->
    <string name="kevbox_settings_reset_live_pins_description">Switching a channel between ExoPlayer and mpv with the player button in full screen saves that choice for the channel. Reset clears these choices, so every channel starts on the default player again.</string>
    <!-- 0.2 AC-26: the guide feed the app adds from the playlist. -->
    <string name="kevbox_epg_automatic">Set up for you</string>
    <!-- Settings › Playlists: how often the channel list downloads again by itself, and a button to do it now. -->
    <string name="kevbox_refresh_playlist">Refresh playlist</string>
    <string name="kevbox_refresh_playlist_description">How often the channel list downloads again by itself. The app checks when it opens or comes back to the screen, and waits while something plays. The TV guide keeps its own timer in EPG sources.</string>
    <string name="kevbox_refresh_app_start">Every time the app opens</string>
    <string name="kevbox_refresh_6h">Every 6 hours</string>
    <string name="kevbox_refresh_12h">Every 12 hours</string>
    <string name="kevbox_refresh_24h">Every 24 hours</string>
    <string name="kevbox_refresh_4d">Every 4 days</string>
    <string name="kevbox_refresh_never">Never</string>
    <string name="kevbox_update_now">Update now</string>
    <string name="kevbox_update_now_description">Downloads the channel list and the TV guide again now.</string>
    <string name="kevbox_updating">Updating…</string>
    <!-- Settings search: extra words that find Refresh playlist and Update now. -->
    <string name="kevbox_search_keywords_refresh">refresh update sync reload download channels playlist list</string>
    <!-- More › Restart app: ends the app and opens it again, as a force stop would. -->
    <string name="kevbox_restart_app">Restart app</string>
    <string name="kevbox_restart_app_body">Closes KevBox Live and opens it again, like a force stop. Use it if something froze or stopped working.</string>
    <string name="kevbox_restart_now">Restart now</string>
    <!-- 0.2 AC-31: Favorites holds channels only. -->
    <string name="kevbox_more_fav_empty_body">Hold OK on a channel and choose Add to Favorites.</string>
    <!-- 0.2 AC-32: More › About. -->
    <string name="kevbox_about_description">KevBox Live plays the live TV channels in your KevBox subscription, with a full programme guide, replays and favourites. Your playlist is set up for you; contact KevBox if a channel is missing.</string>
